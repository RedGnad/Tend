{
  "name": "@tend/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./db": {
      "types": "./build/db/index.d.ts",
      "default": "./build/db/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@bagsfm/bags-sdk": "^1.3.5",
    "@neondatabase/serverless": "^1.1.0",
    "@solana/web3.js": "^1.98.0",
    "bs58": "^6.0.0",
    "drizzle-orm": "^0.45.2",
    "tweetnacl": "^1.0.3",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.0"
  }
}
