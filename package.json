{
  "name": "tend",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "build": "npm run build:shared && npm run build:agent && npm run build:mcp && npm run build:frontend",
    "build:shared": "npm run build -w packages/shared",
    "build:mcp": "npm run build -w packages/mcp-server",
    "build:agent": "npm run build -w packages/agent",
    "build:frontend": "npm run build -w packages/frontend",
    "dev:mcp": "npm run dev -w packages/mcp-server",
    "dev:dashboard": "npm run dev -w packages/frontend",
    "dev:agent": "npm run dev -w packages/agent",
    "start:agent": "npm run build -w packages/shared && npm run build -w packages/agent && npm run start -w packages/agent",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "dotenv": "^17.4.1",
    "playwright": "^1.59.1"
  },
  "optionalDependencies": {
    "@next/swc-darwin-arm64": "^15.5.14"
  }
}
